# Copy to .env (same folder) and fill in. .env is gitignored — never commit it.
# Used only by the Python operator scripts in scripts/. The web app reads web/config.js instead.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
GLP1_SUPABASE_URL=

# Secret / service_role key. Full database access — keep it on your machine only.
GLP1_SUPABASE_SERVICE_KEY=

# Folder holding the private programming content (framework, master spreadsheet, lessons).
# Absolute path, e.g. C:\Users\you\Documents\GLP1\content
GLP1_CONTENT_DIR=

# Later phases (leave blank for now)
ANTHROPIC_API_KEY=
GLP1_VAPID_PUBLIC_KEY=
GLP1_VAPID_PRIVATE_KEY=
